#!/usr/bin/env sh
set -eu

cd "$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

if ! command -v valgrind >/dev/null 2>&1; then
	printf 'valgrind not found; install it and rerun this script.\n' >&2
	exit 127
fi

meson setup --reconfigure build-valgrind --werror -Dbuildtype=debug

ninja -C build-valgrind

valgrind \
	--leak-check=full \
	--show-leak-kinds=definite,possible \
	--track-origins=yes \
	--error-exitcode=125 \
	./build-valgrind/sweetlock --version

# the whole UI and background draw path, without a compositor; fontconfig and GLib keep
# process-wide caches, so leaks are left to LeakSanitizer and its suppressions
preview=$(mktemp -d /tmp/sweetlock-preview-XXXXXX)
trap 'rm -rf "$preview"' EXIT
valgrind \
	--leak-check=no \
	--track-origins=yes \
	--error-exitcode=125 \
	./build-valgrind/sweetlock --no-config --preview "$preview/scene.png" \
	--size 1280x720 --scale 1.5 --set background.mode=layered
# the first preview is a PNG to decode as the avatar and the wallpaper
valgrind \
	--leak-check=no \
	--track-origins=yes \
	--error-exitcode=125 \
	./build-valgrind/sweetlock --no-config --preview "$preview/avatar.png" \
	--set avatar.path="$preview/scene.png" --preview-state revealed \
	--image "$preview/scene.png" --blur 8 --dim 35
