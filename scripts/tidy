#!/usr/bin/env sh
set -eu

cd "$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"

build=${BUILD:-build}

meson setup --reconfigure "$build" --werror
ninja -C "$build"

files=$(find src -type f -name '*.c' -print)
[ -n "$files" ] || exit 0

printf '%s\n' "$files" |
	xargs clang-tidy --quiet --warnings-as-errors='*' -p "$build"
